{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skala.local/schemas/skills.seed.schema.json",
  "title": "SKALA semiconductor skill dummy catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "scenario",
    "disclaimer",
    "skills"
  ],
  "properties": {
    "catalogVersion": {
      "type": "string"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "productId", "designVersion", "lotId", "equipmentId"],
      "properties": {
        "name": { "type": "string" },
        "productId": { "type": "string" },
        "designVersion": { "type": "string" },
        "lotId": { "type": "string" },
        "equipmentId": { "type": "string" }
      }
    },
    "disclaimer": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "domain",
        "category",
        "lifecycleStage",
        "skillType",
        "riskLevel",
        "version",
        "status",
        "shortDescription",
        "useWhen",
        "instructions",
        "requiredInputs",
        "outputFields",
        "demoInput",
        "demoOutput",
        "successCriteria",
        "limitations",
        "relatedSkills",
        "compatibleTargets",
        "authorName",
        "usageCount"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "domain": {
          "enum": ["AX", "FABLESS", "FOUNDRY", "VISUALIZATION", "CROSS_DOMAIN"]
        },
        "category": {
          "enum": [
            "BACKEND",
            "FRONTEND",
            "DEVOPS",
            "DATA_SCIENCE",
            "MOBILE",
            "SECURITY",
            "DATABASE",
            "OTHER"
          ]
        },
        "lifecycleStage": {
          "enum": [
            "KNOWLEDGE_TRANSFER",
            "DESIGN",
            "VERIFICATION",
            "EDA_SIGNOFF",
            "PROCESS_ENGINEERING",
            "EQUIPMENT_OPERATION",
            "QUALITY",
            "REPORTING"
          ]
        },
        "skillType": {
          "enum": [
            "PROMPT",
            "STRUCTURED",
            "CHECKLIST",
            "CODE_TRANSFORM",
            "DIAGNOSTIC",
            "VISUAL_SPEC"
          ]
        },
        "riskLevel": {
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "version": { "type": "string" },
        "status": { "enum": ["DRAFT", "ACTIVE", "ARCHIVED"] },
        "shortDescription": { "type": "string" },
        "useWhen": { "type": "string" },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "requiredInputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "outputFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "demoInput": {
          "type": "object"
        },
        "demoOutput": {
          "type": "object"
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "relatedSkills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "compatibleTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["OPENAI", "ANTHROPIC", "GEMINI", "OLLAMA"]
          }
        },
        "authorName": { "type": "string" },
        "usageCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
